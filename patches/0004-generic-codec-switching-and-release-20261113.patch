--- /dev/null
+++ b/tools/tests/hls-codec-switch.test.cjs
@@ -0,0 +1,432 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+const adapters = require('../../app/src/main/assets/extensions/wolvic_vr_tools/media_adapters.js');
+const bridge = fs.readFileSync(process.env.WOLVIC_PAGE_BRIDGE_SOURCE ||
+  path.resolve(__dirname, '../../app/src/main/assets/extensions/wolvic_vr_tools/page_bridge.js'), 'utf8');
+class Events {
+  constructor() { this.events = new Map(); }
+  addEventListener(name, fn) { if (!this.events.has(name)) this.events.set(name, new Set()); this.events.get(name).add(fn); }
+  removeEventListener(name, fn) { this.events.get(name)?.delete(fn); }
+  dispatchEvent(event) { for (const fn of [...(this.events.get(event.type) || [])]) fn(event); }
+}
+function fixture(options = {}) {
+  let now = 1000, sequence = 0, current = 2, manual = options.manual ? 2 : -1, state;
+  const timers = new Map(), responses = new Map(), attrs = new Map(), writes = [];
+  const mgpState = { intendedState: options.playing ? 'playing' : 'paused' };
+  const window = new Events(), document = new Events(), location = { href: 'https://site.test/video' };
+  const video = Object.assign(new Events(), { tagName: 'VIDEO', isConnected: true, currentSrc: 'blob:owned', src: 'blob:owned', readyState: 4, duration: 100,
+    videoWidth: 1440, videoHeight: 720,
+    currentTime: 12, paused: !options.playing, seeking: false, playbackRate: 1.25, volume: 0.25, muted: true,
+    getAttribute: name => attrs.get(name), setAttribute: (name, value) => attrs.set(name, value),
+    pause() { this.paused = true; }, async play() { this.paused = false; } });
+  const later = (fn, delay) => { const id = ++sequence; timers.set(id, { fn, at: now + delay }); return id; };
+  class Hls {
+    static Events = { LEVEL_SWITCHED: 'levelSwitched', ERROR: 'hlsError',
+      FRAG_LOADED: 'fragLoaded', FRAG_PARSING_INIT_SEGMENT: 'fragInit',
+      MANIFEST_LOADING: 'manifestLoading', MANIFEST_PARSED: 'manifestParsed',
+      MEDIA_DETACHED: 'mediaDetached', DESTROYING: 'destroying' };
+    constructor() {
+      this.media = video; this.url = 'https://cdn.test/owned-master.m3u8'; this.listeners = new Map();
+      this.minAutoLevel = 0; this.maxAutoLevel = 5; this.autoLevelCapping = -1; this.audioTrack = 0;
+      this.audioTracks = [{ lang: 'en', name: 'main' }];
+      this.levels = [360, 360, 720, 720, 1080, 1080].map((height, index) => ({
+        width: height * 2, height, frameRate: 30, bitrate: height * (index % 2 ? 500 : 1000),
+        videoCodec: options.undeclared ? undefined : index % 2 ? 'av01.0.04M.08' : 'avc1.640028',
+        url: ['https://cdn.test/' + index + '.m3u8'], details: { targetduration: 1 } }));
+    }
+    get autoLevelEnabled() { return manual === -1; }
+    set autoLevelEnabled(_) { assert.fail('autoLevelEnabled is read-only'); }
+    get currentLevel() { return current; }
+    set currentLevel(_) { assert.fail('Cross-codec layout changes require a fresh media pipeline'); }
+    get nextLevel() { return 3; }
+    set nextLevel(_) { assert.fail('A requested next level is not actual playback evidence'); }
+    get loadLevel() { return current; }
+    set loadLevel(index) {
+      writes.push(['loadLevel', index]); manual = index;
+      if (index === -1 && options.revertOnAuto) later(() => { current = 2; this.emit('levelSwitched', { level: 2 }); }, 50);
+    }
+    get manualLevel() { return options.legacy ? undefined : manual; }
+    attachMedia(media) { this.media = media; }
+    get nextLoadLevel() { return manual; }
+    set nextLoadLevel(index) { this.loadLevel = index; }
+    get nextAutoLevel() { return this._nextAutoLevel ?? 2; }
+    set nextAutoLevel(index) { this._nextAutoLevel = index; }
+    stopLoad() { writes.push(['stopLoad']); }
+    recoverMediaError() {
+      writes.push(['recoverMediaError']);
+      this.emit('mediaDetached', {});
+      const index = manual; current = -1; video.readyState = 0;
+      video.src = video.currentSrc = 'blob:rebuild-' + sequence++;
+      if (options.changeOwnerOnReset) this.url = 'https://cdn.test/replaced.m3u8';
+      if (options.noApply && index !== 2 || options.failRollback && index === 2) return;
+      const complete = () => {
+        current = index; video.readyState = options.metadataOnly && index !== 2 ? 1 : 4;
+        video.videoWidth = options.zeroDimensions && index !== 2 ? 0 : this.levels[index].width;
+        video.videoHeight = options.zeroDimensions && index !== 2 ? 0 : this.levels[index].height;
+        if (options.undeclared && !options.noParsedAfterRebuild) {
+          const frag = { type: 'main', level: index };
+          this.levels[index].details.fragments = [frag];
+          this.streamController = { fragCurrent: frag };
+          this.emit('fragLoaded', { frag });
+          this.emit('fragInit', { id: 'main', tracks: { video: {
+            codec: index % 2 ? 'av01.0.04M.08' : 'avc1.640028',
+            metadata: { width: this.levels[index].width, height: this.levels[index].height }
+          } } });
+        }
+        video.dispatchEvent({ type: 'loadedmetadata' });
+        if (video.readyState >= 2) video.dispatchEvent({ type: 'loadeddata' });
+        this.emit('levelSwitched', { level: index });
+      };
+      if (options.syncApply) complete(); else later(complete, 100);
+    }
+    on(name, fn) { if (!this.listeners.has(name)) this.listeners.set(name, new Set()); this.listeners.get(name).add(fn); }
+    off(name, fn) { this.listeners.get(name)?.delete(fn); }
+    emit(name, data) { for (const fn of [...(this.listeners.get(name) || [])]) fn(name, data); }
+    startLoad() { assert.fail('Codec selection must not indiscriminately restart the loader'); }
+  }
+  window.hls = new Hls(); window.Hls = Hls;
+  document.querySelectorAll = selector => selector === 'video' ? [video] : [];
+  window.addEventListener('wolvic-videojs-vr-state', e => { state = JSON.parse(e.detail)[0]; });
+  window.addEventListener('wolvic-videojs-vr-result', e => { const r = JSON.parse(e.detail); responses.set(r.requestId, r); });
+  const context = { window, document, location, URL,
+    Date: class extends Date { static now() { return now; } },
+    CustomEvent: class { constructor(type, init) { this.type = type; this.detail = init.detail; } },
+    setTimeout: later, clearTimeout: id => timers.delete(id), requestAnimationFrame: fn => fn() };
+  if (options.mgp) {
+    window.document = document; window.location = location;
+    const container = { isConnected: true, contains: item => item === video, querySelectorAll: () => [video] };
+    document.querySelector = () => null;
+    document.getElementById = () => container;
+    window.MGP = { players: { main: { getCurrentState: () => mgpState, getCurrentTime: () => video.currentTime } },
+      inspectOriginal: () => ({ mainRoll: { duration: 100, videoUrl: location.href, mediaDefinition: [{}] } }) };
+    vm.runInNewContext(fs.readFileSync(path.resolve(__dirname,
+      '../../app/src/main/assets/extensions/wolvic_vr_tools/mgp_adapter.js'), 'utf8'), context);
+  }
+  vm.runInNewContext(bridge, context);
+  if (options.mgp) {
+    window.hls.attachMedia(video);
+    document.dispatchEvent({ type: 'wolvic-videojs-vr-command', detail: JSON.stringify({ action: 'inspect' }) });
+  }
+  return { window, document, location, video, mgpState, hls: window.hls, writes, responses, timers, state: () => state,
+    inspect() { document.dispatchEvent({ type: 'wolvic-videojs-vr-command', detail: JSON.stringify({ action: 'inspect' }) }); },
+    parse(index, codec, extra = {}) {
+      const frag = { type: extra.fragmentType || 'main', level: index };
+      window.hls.levels[index].details.fragments = extra.stale ? [] : [extra.initSegment ? { initSegment: frag } : frag];
+      window.hls.streamController = { fragCurrent: frag };
+      if (!extra.skipLoaded) window.hls.emit('fragLoaded', { frag });
+      window.hls.emit('fragInit', { id: extra.id || 'main', ...(extra.direct ? { frag } : {}),
+        tracks: { [extra.trackType || 'video']: { codec,
+          metadata: { width: extra.width || window.hls.levels[index]?.width,
+            height: window.hls.levels[index]?.height } } } });
+    },
+    switch(extra = {}) {
+      const requestId = 'hls-' + (++sequence);
+      document.dispatchEvent({ type: 'wolvic-videojs-vr-command', detail: JSON.stringify({
+        action: 'set-hls-level', requestId, videoId: state.id, codecContext: state.hlsCodecContext,
+        levelIndex: 3, codec: 'AV1', ...extra }) });
+      return requestId;
+    },
+    async advance(ms) {
+      const stop = now + ms;
+      for (let guard = 0; guard < 20000; guard++) {
+        const pending = [...timers].filter(([, t]) => t.at <= stop).sort((a, b) => a[1].at - b[1].at)[0];
+        if (!pending) break;
+        const [id, task] = pending; timers.delete(id);
+        if (!video.paused) video.currentTime += (task.at - now) * video.playbackRate / 1000;
+        now = task.at; task.fn(); await Promise.resolve(); await Promise.resolve();
+      }
+      if (!video.paused) video.currentTime += (stop - now) * video.playbackRate / 1000;
+      now = stop; await new Promise(setImmediate);
+    } };
+}
+test('HLS codec switch preserves automatic mode without writing a read-only property', async () => {
+  const f = fixture(), id = f.switch(); await f.advance(500); assert.equal(f.responses.has(id), false);
+  await f.advance(1000); const r = f.responses.get(id);
+  assert.equal(r.ok, true); assert.equal(r.detail.codec, 'AV1'); assert.equal(r.detail.autoLevelEnabled, true);
+  assert.equal(f.hls.manualLevel, -1);
+  assert.deepEqual(f.writes, [['stopLoad'], ['loadLevel', 3], ['recoverMediaError'], ['loadLevel', -1]]);
+  assert.equal(f.video.currentTime, 12); assert.equal(f.video.paused, true);
+  assert.equal(f.video.playbackRate, 1.25); assert.equal(f.video.volume, 0.25); assert.equal(f.video.muted, true);
+});
+test('production MGP policy is installed by the real bridge and retains native quality mapping after success', async () => {
+  const f = fixture({ mgp: true }), id = f.switch();
+  await f.advance(1500);
+  assert.equal(f.responses.get(id).ok, true);
+  f.hls.loadLevel = 4;
+  assert.equal(f.hls.manualLevel, 5);
+  f.window.dispatchEvent({ type: 'pagehide' });
+  assert.equal(Object.hasOwn(f.hls, 'loadLevel'), false);
+});
+test('failed MGP target recovers original codec and removes newly installed restriction', async () => {
+  const f = fixture({ mgp: true, noApply: true }), id = f.switch();
+  await f.advance(28000);
+  const result = f.responses.get(id);
+  assert.equal(result.ok, false);
+  assert.equal(result.recovery.restored, true);
+  assert.equal(Object.hasOwn(f.hls, 'loadLevel'), false);
+  f.hls.loadLevel = 4;
+  assert.equal(f.hls.manualLevel, 4);
+});
+test('MGP pause intent during buffer loading is retained before metadata restoration', async () => {
+  const f = fixture({ mgp: true, playing: true }), id = f.switch();
+  f.mgpState.intendedState = 'paused'; f.video.pause();
+  await f.advance(1500);
+  const result = f.responses.get(id);
+  assert.equal(result.outcome, 'interrupted');
+  assert.equal(result.reason, 'hls-playback-intent-changed');
+  assert.equal(result.recovery.attempted, false);
+  assert.equal(f.video.paused, true);
+  assert.equal(f.writes.filter(item => item[0] === 'recoverMediaError').length, 1);
+});
+test('native quality intent during initial buffer loading does not trigger an old-state recovery', async () => {
+  const f = fixture(), id = f.switch();
+  f.hls.loadLevel = 5;
+  await f.advance(1500);
+  const result = f.responses.get(id);
+  assert.equal(result.outcome, 'interrupted');
+  assert.equal(result.reason, 'hls-quality-changed');
+  assert.equal(result.recovery.attempted, false);
+  assert.equal(f.hls.manualLevel, 5);
+  assert.equal(f.writes.filter(item => item[0] === 'recoverMediaError').length, 1);
+});
+test('playback changes during final confirmation are retained without an old-state rollback', async () => {
+  for (const [property, value] of [['paused', false], ['playbackRate', 1.75], ['volume', 0.7], ['muted', false]]) {
+    const f = fixture(), id = f.switch();
+    await f.advance(500);
+    f.video[property] = value;
+    await f.advance(100);
+    const result = f.responses.get(id);
+    assert.equal(result.ok, false, property);
+    assert.equal(result.reason, 'hls-playback-state-changed', property);
+    assert.equal(result.recovery.attempted, false, property);
+    assert.equal(f.video[property], value, property);
+    assert.equal(f.writes.filter(item => item[0] === 'recoverMediaError').length, 1, property);
