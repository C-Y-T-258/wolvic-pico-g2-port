+  }
+
+  function codecCandidateFamilies(candidates) {
+    return [...new Set((Array.isArray(candidates) ? candidates : [])
+      .map(item => canonicalCodecCandidate(item).codec).filter(Boolean))];
+  }
+
+  function hasCodecPair(candidates) {
+    return codecCandidateFamilies(candidates).length >= 2;
+  }
+
+  function sameCodecContent(left, right) {
+    if (!left || !right) return false;
+    const leftId = String(left.contentId || "");
+    const rightId = String(right.contentId || "");
+    if (leftId && rightId && leftId !== rightId) return false;
+    const leftContext = left.codecContext || left.context;
+    const rightContext = right.codecContext || right.context;
+    if (leftContext && rightContext &&
+        leftContext.document && rightContext.document &&
+        leftContext.document !== rightContext.document) return false;
+    return true;
+  }
+
+  function normalizeCodecCandidates(candidates, defaults = {}) {
+    const normalized = (Array.isArray(candidates) ? candidates : [])
+      .map(item => canonicalCodecCandidate(item, defaults))
+      .filter(item => item.codec && item.selectable);
+    const families = codecCandidateFamilies(normalized);
+    return {
+      candidates: normalized,
+      families,
+      hasPair: families.length >= 2,
+      reason: families.length >= 2 ? null : families.length ? "fewer-than-two-codecs" : "codec-unknown"
+    };
+  }
+
+  function summarizeCodecSources(readResult, contentId) {
+    if (!readResult || !readResult.ok || !contentId) {
+      return { ok: false, reason: readResult && readResult.reason ||
+        (contentId ? "manifest-read-failed" : "content-id-unavailable"),
+        candidates: [], contentId, failures: [] };
+    }
+    const candidates = [];
+    const failures = [];
+    for (const item of readResult && readResult.manifests || []) {
+      if (!item.ok) {
+        failures.push({ id: item.id, reason: item.reason, status: item.status });
+        continue;
+      }
+      const parsed = parseHlsMasterPlaylist(item.text, item.url, contentId);
+      const summary = summarizeCodecCandidates(parsed, item.id);
+      if (!summary.ok) {
+        failures.push({ id: item.id, reason: summary.reason });
+        continue;
+      }
+      if (!candidates.some(candidate => candidate.url === item.url)) {
+        candidates.push({ id: item.id, label: summary.codec, codec: summary.codec,
+          type: item.type || "application/x-mpegURL", url: item.url,
+          variants: summary.candidates, sourceIndex: item.sourceIndex, role: item.role,
+          contentId, codecContext: readResult.codecContext });
+      }
+    }
+    if (new Set(candidates.map(item => item.codec)).size >= 2) {
+      return { ok: true, reason: null, candidates, contentId, failures,
+        codecContext: readResult.codecContext };
+    }
+    const reason = readResult && !readResult.ok ? readResult.reason : failures.length
+      ? failures.every(item => item.reason === "codec-unknown")
+        ? "codec-unknown" : "codec-discovery-incomplete"
+      : "fewer-than-two-codecs";
+    return { ok: false, reason, candidates: [], contentId, failures };
+  }
+
+  function selectHlsCodecCandidates(state) {
+    const levels = Array.isArray(state && state.hlsLevels) ? state.hlsLevels : [];
+    const manual = state && state.hlsAutoLevelEnabled === false;
+    const wantedIndex = manual ? state.hlsManualLevel : state && state.hlsCurrentLevel;
+    const wanted = levels.find(item => item.levelIndex === wantedIndex) || {};
+    const groups = new Map();
+    for (const item of levels) {
+      if (!item.codec) continue;
+      if (!groups.has(item.codec)) groups.set(item.codec, []);
+      groups.get(item.codec).push(item);
+    }
+    return [...groups.values()].map(items => {
+      const allowed = items.filter(item => manual
+        ? item.width === wanted.width && item.height === wanted.height &&
+          (!wanted.frameRate || item.frameRate === wanted.frameRate)
+        : (!Number.isInteger(state.hlsMaxAutoLevel) || item.levelIndex <= state.hlsMaxAutoLevel) &&
+          (!Number.isInteger(state.hlsMinAutoLevel) || item.levelIndex >= state.hlsMinAutoLevel));
