+              typeof api?.getCurrentState !== "function" || typeof api?.getCurrentTime !== "function") continue;
+          matches.push({ id, api, container, contentUrl, duration, definitions: content.mediaDefinition });
+        }
+        if (matches.length !== 1) return null;
+        return matches[0];
+      } catch (_) { return null; }
+    }
+    function mainVideo(record, video) {
+      const state = record.api.getCurrentState();
+      if (!environment.active() || state.adRollReady || state.adRollStarted || state.casting ||
+          state.airplaying || video.readyState < 2) return false;
+      const matches = Array.from(record.container.querySelectorAll("video")).filter(item =>
+        item.isConnected && item.readyState >= 2 && Number.isFinite(item.duration) &&
+        Math.abs(item.duration - record.duration) < 2);
+      return matches.length === 1 && matches[0] === video;
+    }
