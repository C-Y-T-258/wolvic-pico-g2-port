+test('two background workers deduplicate pending resources and preserve the document budget', async () => {
+  const f = fixture({ pending: true });
+  const jobs = [f.request(), f.request('https://cdn.example/second.mp4')];
+  await new Promise(resolve => setImmediate(resolve));
+  assert.equal(f.reads(), 2); assert.equal(f.loads(), 1);
+  assert.equal((await f.request()).reason, 'metadata-background-budget');
+  for (const resolve of f.pending.splice(0)) resolve();
+  assert.ok((await Promise.all(jobs)).every(result => result.ok));
+  for (let index = 0; index < 6; index++) {
+    const job = f.request('https://cdn.example/' + index + '.mp4');
