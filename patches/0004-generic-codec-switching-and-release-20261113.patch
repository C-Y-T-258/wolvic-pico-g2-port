@@ -0,0 +1,192 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const assets = path.resolve(__dirname, '../../app/src/main/assets/extensions/wolvic_vr_tools');
+const adapters = require(path.join(assets, 'media_adapters.js'));
+const source = fs.readFileSync(path.join(assets, 'mgp_adapter.js'), 'utf8');
+function fixture(options = {}) {
+  const handlers = () => ({
+    listeners: new Map(),
+    addEventListener(name, callback) {
+      const set = this.listeners.get(name) || new Set(); set.add(callback); this.listeners.set(name, set);
+    },
+    removeEventListener(name, callback) { this.listeners.get(name)?.delete(callback); },
+    emit(name, detail) { for (const callback of this.listeners.get(name) || []) callback(detail || { type: name }); }
+  });
+  const urls = ['https://media.test/h264.m3u8', 'https://media.test/av1.m3u8'];
+  let now = 0, documentId = 'document-1', frames = 50, active = true, intent = 'playing', quality = 360;
+  const video = { ...handlers(), isConnected: true, readyState: 4, duration: 100, currentTime: 10,
+    paused: false, playbackRate: 1.5, volume: .4, muted: true, videoWidth: 720, videoHeight: 360,
+    seeking: false, textTracks: [], getVideoPlaybackQuality: () => ({ totalVideoFrames: frames }) };
+  const container = { ...handlers(), isConnected: true, contains: item => item === video,
+    querySelectorAll: () => [video] };
+  const content = { duration: 100, videoUrl: 'https://watch.test/one',
+    mediaDefinition: urls.map(videoUrl => ({ format: 'hls', videoUrl, quality: [240, 360] })) };
+  const api = { getCurrentState: () => ({ intendedState: intent }),
+    getCurrentTime: () => video.currentTime,
+    quality: { get: () => quality, set: request => {
+      if (request.auto || request.quality === 'auto') { quality = 'auto'; engine.autoLevelEnabled = true; }
+      else { quality = request.quality; engine.autoLevelEnabled = false; }
+    } },
+    pause: async () => { video.paused = true; intent = 'paused'; },
+    play: async () => { video.paused = false; intent = 'playing'; } };
+  const loads = [];
+  class Hls {
+    static Events = { MANIFEST_LOADING: 'loading', MANIFEST_PARSED: 'parsed',
+      FRAG_PARSING_INIT_SEGMENT: 'init', ERROR: 'error' };
+    constructor() { Object.assign(this, handlers()); this.url = urls[0]; this.autoLevelEnabled = false;
+      this.manualLevel = 1; this._currentLevel = 1; this.audioTracks = []; this.subtitleTracks = [];
+      this.levels = this.makeLevels(false); }
+    makeLevels(av1) { return [240, 360].map(height => ({
+      width: height * 2, height, frameRate: 30, videoCodec: av1 ? 'av01.0.01M.08' : 'avc1.4d401f' })); }
+    attachMedia(media) { this.media = media; }
+    on(name, callback) { this.addEventListener(name, callback); }
+    off(name, callback) { this.removeEventListener(name, callback); }
+    once(name, callback) { const wrapped = (...args) => { this.off(name, wrapped); callback(...args); }; this.on(name, wrapped); }
+    get currentLevel() { return this._currentLevel; }
+    set currentLevel(value) { this._currentLevel = value; this.manualLevel = value;
+      this.autoLevelEnabled = false; video.videoWidth = this.levels[value].width; video.videoHeight = this.levels[value].height; }
+    stopLoad() {}
+    startLoad() {}
+    fire(name, data) { for (const callback of this.listeners.get(name) || []) callback(name, data); }
+    loadSource(url) {
+      this.url = url; loads.push(url); this.fire('loading');
+      const av1 = url === urls[1];
+      video.readyState = 0;
+      queueMicrotask(() => {
+        options.onLoad?.(f, url);
+        if (av1 && options.failTarget) { this.fire('error', { fatal: true, details: 'controlled-target-error' }); return; }
+        if (av1 && options.hangTarget) return;
+        this.levels = this.makeLevels(av1);
+        if (options.resetHostQuality) quality = 360;
+        this.fire('parsed');
+        video.readyState = 4; video.videoWidth = this.levels[this.currentLevel].width;
+        video.videoHeight = this.levels[this.currentLevel].height;
+        this.fire('init', { tracks: { video: { codec: av1 ? 'av01.0.01M.08' : 'avc1.4d401f' } } });
+      });
+    }
+  }
+  const document = { ...handlers(), querySelector: () => null, getElementById: () => container };
+  const window = { ...handlers(), document, location: { href: content.videoUrl }, Hls,
+    WolvicMediaAdapters: adapters, MGP: { players: { main: api }, inspectOriginal: () => ({ mainRoll: content }) } };
+  const clock = class extends Date { static now() { return now; } };
+  vm.runInNewContext(source, { window, URL, Date: clock, setTimeout: (callback, ms) => {
+    now += ms;
+    if (!video.paused && video.readyState >= 2) { video.currentTime += ms / 1000 * video.playbackRate; frames += 2; }
+    queueMicrotask(callback);
+  } });
+  const manifest = av1 => '#EXTM3U\n' + [240, 360].map(height =>
+    `#EXT-X-STREAM-INF:BANDWIDTH=500000,RESOLUTION=${height * 2}x${height},FRAME-RATE=30,CODECS="${av1 ? 'av01.0.01M.08' : 'avc1.4d401f'},mp4a.40.2"\nhttps://media.test/${height}-${av1}.m3u8\n`).join('');
+  const adapter = window.WolvicMgpAdapter.create({ active: () => active, document: () => documentId,
+    videoId: () => 'video-1', readManifest: async url => ({ ok: true, text: manifest(url === urls[1]) }) });
+  const engine = new Hls(); engine.attachMedia(video);
