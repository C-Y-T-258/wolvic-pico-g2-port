+    }
+    if (!candidates.length) return { ok: false, reason: "no-variants" };
+    return { ok: true, kind: "hls-master", manifestUrl: resolveUrl(manifestUrl, manifestUrl),
+      contentId: String(contentId || ""), candidates };
+  }
+
+  function isPlaylistUrl(value) {
+    return /(?:\.m3u8(?:$|[?#])|\.mpd(?:$|[?#]))/i.test(String(value || ""));
+  }
