+      player.tech_ = makeTech(next, true);
+      state.time = 0;
+      state.start = clock.now;
+      state.paused = true;
+      video.currentSrc = `blob:https://site.test/reload-${count}`;
+      video.readyState = 0;
+      video.error = null;
+      if (options.hangSource) return;
+      clock.setTimeout(() => {
+        if (options.failSource === count) {
+          video.error = { code: 4 };
