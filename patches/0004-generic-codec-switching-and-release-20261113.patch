+    const type = String(source && source.type || "").split(";")[0].trim().toLowerCase();
+    if (["application/x-mpegurl", "application/vnd.apple.mpegurl",
+      "audio/mpegurl", "audio/x-mpegurl"].includes(type)) return true;
+    if (type && type !== "application/octet-stream") return false;
+    return /\.m3u8(?:$|[?#])/i.test(String(source && source.url || ""));
+  }
+
+  function codecDiscoveryKey(state, identity) {
+    return JSON.stringify([identity && identity.document, identity && identity.element,
+      identity && identity.pageUri, state && state.id, state && (state.codecCatalogContext || state.codecContext),
+      state && state.sourceContentId, state && state.sourceGroups]);
+  }
+
+  function canonicalCodecCandidate(candidate, defaults = {}) {
+    const item = candidate || {};
+    const codec = item.codec || item.codecFamily || "";
+    const id = String(item.id ?? item.nodeIndex ?? defaults.id ?? "");
+    const width = Number(item.width) || 0;
+    const height = Number(item.height) || 0;
+    const selectable = item.selectable !== false && item.supported !== false;
+    return {
+      ...item,
+      id,
+      nodeIndex: item.nodeIndex || defaults.nodeIndex || id,
