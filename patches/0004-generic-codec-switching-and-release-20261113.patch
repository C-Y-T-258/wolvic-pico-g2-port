+test('explicit success requires advancing decoded frames as well as media time', async () => {
+  assert.equal(await presentation().wait(), 'frames-and-time-advancing');
+  await assert.rejects(presentation({ noFrames: true }).wait(), /source-presentation-timeout/);
+});
+test('paused source confirmation never starts playback and waits for a decoded seek target', async () => {
+  const f = presentation({ paused: true, tick(video, now) {
+    if (now >= 100) { video.seeking = false; video.readyState = 2; }
+  } });
+  f.video.seeking = true; f.video.readyState = 1;
+  assert.equal(await f.wait(), 'decoded-and-paused');
+  assert.equal(f.video.paused, true);
+  assert.equal(f.video.currentTime, 37);
+});
+test('metadata alone or an incorrect paused position cannot confirm the source', async () => {
+  const f = presentation({ paused: true }); f.video.readyState = 1;
+  await assert.rejects(f.wait(), /source-presentation-timeout/);
+  const wrong = presentation({ paused: true }); wrong.video.currentTime = 0;
+  await assert.rejects(wrong.wait(), /source-presentation-timeout/);
+});
+test('presentation confirmation rejects a late decode error', async () => {
+  const f = presentation({ tick(video) { video.error = { code: 3 }; } });
+  await assert.rejects(f.wait(), /source-playback-error/);
+});
+test('presentation confirmation rejects navigation and replacement sources', async () => {
+  await assert.rejects(presentation({ tick(video, now, navigate) { navigate(); } }).wait(),
+    /media-identity-changed/);
+  await assert.rejects(presentation({ tick(video) { video.currentSrc = 'https://cdn.test/other.mp4'; } }).wait(),
+    /source-not-selected/);
+});
+test('presentation confirmation does not overwrite a new playback intent', async () => {
+  const f = presentation({ tick(video) { video.pause = () => {}; video.paused = true; video.volume = .7; } });
+  await assert.rejects(f.wait(), /source-playback-state-changed/);
+  assert.equal(f.video.paused, true);
+  assert.equal(f.video.volume, .7);
+});
