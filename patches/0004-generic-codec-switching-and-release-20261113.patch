+    levelIndex: state.hlsLevels.find(item => item.codec === 'AV1' && item.height === 360).levelIndex });
+  return f;
+}
+test('independent masters use declared main content, parsed codec and per-document catalogue', async () => {
+  const f = fixture(), state = await f.ready();
+  assert.equal(state.hlsLevels.length, 4);
+  assert.equal(state.hlsCodecContext.kind, 'mgp-independent-hls');
+  const old = f.request(state); f.changeDocument();
+  assert.equal((await f.adapter.executeIndependent(f.video, old)).reason, 'media-identity-changed');
+  assert.equal(f.loads.length, 0);
+});
+test('independent source transaction preserves manual dimensions, rate, volume and paused state', async () => {
+  for (const paused of [false, true]) {
+    const f = fixture(); f.video.paused = paused; f.setIntent(paused ? 'paused' : 'playing');
+    const state = await f.ready(), result = await f.adapter.executeIndependent(f.video, f.request(state));
+    assert.equal(result.ok, true);
+    assert.equal(f.video.paused, paused); assert.equal(f.video.playbackRate, 1.5);
+    assert.equal(f.video.volume, .4); assert.equal(f.video.videoHeight, 360);
+    assert.equal(f.engine.url, f.urls[1]); assert.equal(f.engine.media, f.video);
+    assert.equal(f.engine.autoLevelEnabled, false);
+  }
+});
+test('target error and timeout restore original master and confirm playback', async () => {
+  for (const options of [{ failTarget: true }, { hangTarget: true }]) {
+    const f = fixture(options), state = await f.ready();
+    const result = await f.adapter.executeIndependent(f.video, f.request(state));
+    assert.equal(result.ok, false); assert.equal(result.recovery.attempted, true);
+    assert.equal(result.recovery.restored, true);
+    assert.equal(f.engine.url, f.urls[0]); assert.equal(f.video.paused, false);
+  }
+});
+test('Auto survives the hosts temporary default quality during manifest initialization', async () => {
+  const f = fixture({ resetHostQuality: true });
