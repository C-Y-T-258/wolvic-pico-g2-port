@@ -0,0 +1,58 @@
+(() => {
+  "use strict";
+  let loading, queued = 0, nextLane = 0;
+  const lanes = [Promise.resolve(), Promise.resolve()];
+  const documents = new Map();
+  const validUrl = value => {
+    try {
+      const url = new URL(value), host = url.hostname.toLowerCase();
+      return url.protocol === "https:" && !url.username && !url.password &&
+        host.includes(".") && !/^[\d.]+$/.test(host) &&
+        !/(^|\.)(localhost|local|internal|invalid|test)$/.test(host) &&
+        !host.includes(":");
+    } catch (_) { return false; }
+  };
+  function parser() {
+    if (!loading) loading = new Promise((resolve, reject) => {
+      const script = document.createElement("script");
+      script.src = browser.runtime.getURL("vendor/mp4box-2.5.0.js");
+      script.onload = () => globalThis.WolvicMp4Box ? resolve(globalThis.WolvicMp4Box) : reject(Error("parser-unavailable"));
+      script.onerror = () => reject(Error("parser-load-failed"));
+      document.head.append(script);
+    });
+    return loading;
+  }
+  browser.runtime.onMessage.addListener((message, sender) => {
+    if (message?.type !== "wolvic-mp4-metadata") return undefined;
+    if (!sender?.tab || !Number.isInteger(sender.tab.id) || !/^https?:/.test(sender.url || "") ||
+        typeof message.url !== "string" || message.url.length > 8192 || !validUrl(message.url))
+      return Promise.resolve({ ok: false, reason: "invalid-metadata-request" });
+    const key = sender.tab.id + ":" + sender.frameId + ":" + (sender.documentId || sender.url);
+    if (!documents.has(key)) {
+      if (documents.size >= 128) documents.delete(documents.keys().next().value);
+      documents.set(key, { started: Date.now(), count: 0, pending: new Set() });
+    }
+    const bucket = documents.get(key);
+    if (Date.now() - bucket.started >= 60000) { bucket.started = Date.now(); bucket.count = 0; }
+    if (queued >= 8 || bucket.count >= 8 || bucket.pending.has(message.url))
+      return Promise.resolve({ ok: false, reason: "metadata-background-budget" });
+    bucket.count++; bucket.pending.add(message.url); queued++;
+    const lane = nextLane++ % lanes.length;
+    const task = lanes[lane].then(async () => {
+      const resource = new URL(message.url);
+      const allowed = await browser.permissions.contains({
+        origins: [resource.protocol + "//" + resource.hostname + "/*"]
+      });
+      if (!allowed) return { ok: false, reason: "metadata-host-permission-unavailable" };
+      const result = await WolvicMp4Metadata.inspect(message.url,
+        { parser: await parser(), fetch: globalThis.fetch.bind(globalThis) });
+      return { ok: true, metadata: result };
+    }).catch(error => ({ ok: false, reason: String(error.message || error) }))
+      .finally(() => { queued--; bucket.pending.delete(message.url); });
+    lanes[lane] = task.then(() => {});
+    return task;
+  });
+  browser.tabs.onRemoved.addListener(tabId => {
+    for (const key of documents.keys()) if (key.startsWith(tabId + ":")) documents.delete(key);
+  });
+})();
