+      if (!video.paused) {
+        video.currentTime += milliseconds / 1000 * video.playbackRate;
+        if (!options.noFrames) frames++;
+      }
+      options.tick?.(video, now, () => { current = false; });
+      queueMicrotask(callback);
+    }
+  });
+  vm.runInContext(actual('waitForMediaPresentation'), c);
+  return { video, original, wait: () => c.waitForMediaPresentation(video, 'https://cdn.test/avc.mp4', original) };
