+function fixture() {
+  let receive, remove;
+  const calls = [], targets = new Map();
+  const browser = { runtime: { onMessage: { addListener(fn) { receive = fn; } } },
+    tabs: { onRemoved: { addListener(fn) { remove = fn; } },
+      async sendMessage(tabId, message, options) {
+        calls.push({ tabId, message, options });
+        const target = targets.get(tabId + ':' + options.frameId);
+        if (!target) throw Error('no-frame');
+        return target(message);
+      } } };
+  vm.runInNewContext(source, { browser, URL, Map, Promise, Number, setTimeout, clearTimeout });
+  const top = { tab: { id: 1 }, frameId: 0, url: 'https://top.test/watch' };
+  const child = { tab: { id: 1 }, frameId: 3, url: 'https://embedded.test/watch' };
+  const documentId = 'document-123';
+  const register = (sender = child, id = documentId) => receive({ type: 'wolvic-frame-register', documentId: id }, sender);
+  const list = sender => receive({ type: 'wolvic-frame-list' }, sender || top);
+  const request = overrides => ({ type: 'wolvic-frame-switch', frameId: 3, documentId,
+    videoId: 'wv-1', candidateId: 'VP9', codecContext: { document: 'D', generation: 1 }, ...overrides });
+  return { receive: (message, sender = top) => receive(message, sender), register, list,
+    remove: id => remove(id), targets, calls, child, top, documentId, request };
+}
+test('only a content-script sender with tab and frame identity can register', async () => {
+  const f = fixture();
+  for (const sender of [{}, { ...f.child, url: 'file:///tmp/test' }]) {
+    assert.equal((await f.register(sender)).ok, false);
+  }
+  assert.equal((await f.register()).ok, true);
+});
+test('top document queries exactly its registered child frame and does not trust payload routing fields', async () => {
+  const f = fixture(); await f.register();
