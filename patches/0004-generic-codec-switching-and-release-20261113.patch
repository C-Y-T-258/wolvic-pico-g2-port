+package com.igalia.wolvic.ui.widgets.menus;
+
+import android.content.Context;
+import android.content.res.Configuration;
+import android.view.View;
+
+import com.igalia.wolvic.R;
+import com.igalia.wolvic.ui.widgets.UIWidget;
+import com.igalia.wolvic.ui.widgets.WidgetPlacement;
+import com.igalia.wolvic.utils.ViewUtils;
+
+import java.util.ArrayList;
+
+/** Aspect choices for the front-facing 3D projection modes. */
+public class VideoAspectMenuWidget extends MenuWidget {
+    public static final int VIDEO_ASPECT_AUTO = 0;
+    public static final int VIDEO_ASPECT_SINGLE_EYE = 1;
+    public static final int VIDEO_ASPECT_ORIGINAL = 2;
+
+    public interface Delegate {
+        void onVideoAspectClick(int aAspectMode);
+    }
+
+    private final ArrayList<MenuItem> mItems = new ArrayList<>();
+    private Delegate mDelegate;
+
+    public VideoAspectMenuWidget(Context aContext) {
+        super(aContext, R.layout.menu);
+        updateUI();
+    }
+
+    @Override
+    protected void initializeWidgetPlacement(WidgetPlacement aPlacement) {
+        aPlacement.visible = false;
+        aPlacement.width = WidgetPlacement.dpDimension(getContext(), R.dimen.video_projection_menu_width);
+        aPlacement.anchorX = 0.0f;
+        aPlacement.anchorY = 0.5f;
+        aPlacement.parentAnchorX = 1.0f;
+        aPlacement.parentAnchorY = 0.5f;
+        aPlacement.translationX = WidgetPlacement.dpDimension(getContext(), R.dimen.video_aspect_menu_gap);
+        aPlacement.translationZ = 3.0f;
+    }
+
+    @Override
+    public void updateUI() {
+        // MenuWidget invokes updateUI from its constructor before subclass fields exist.
+        if (mItems == null) {
+            return;
+        }
+        super.updateUI();
+        mItems.clear();
+        mItems.add(new MenuItem(getContext().getString(R.string.video_aspect_auto), 0,
+                () -> handleClick(VIDEO_ASPECT_AUTO)));
+        mItems.add(new MenuItem(getContext().getString(R.string.video_aspect_force_single_eye), 0,
+                () -> handleClick(VIDEO_ASPECT_SINGLE_EYE)));
+        mItems.add(new MenuItem(getContext().getString(R.string.video_aspect_original), 0,
+                () -> handleClick(VIDEO_ASPECT_ORIGINAL)));
+        updateMenuItems(mItems);
+        mWidgetPlacement.height = mItems.size() * WidgetPlacement.dpDimension(getContext(), R.dimen.menu_item_height);
+        mWidgetPlacement.height += mBorderWidth * 2;
+    }
+
+    @Override
+    public void onConfigurationChanged(Configuration newConfig) {
+        super.onConfigurationChanged(newConfig);
+        updateUI();
+    }
+
+    public void setParentWidget(UIWidget aParent) {
+        mWidgetPlacement.parentHandle = aParent.getHandle();
+    }
+
+    public void setDelegate(Delegate aDelegate) {
+        mDelegate = aDelegate;
+    }
+
+    public void setProjectionRow(int aRow, int aParentMenuHeight) {
+        final int itemHeight = WidgetPlacement.dpDimension(getContext(), R.dimen.menu_item_height);
+        final float rowCenter = mBorderWidth + ((float) aRow + 0.5f) * itemHeight;
+        mWidgetPlacement.parentAnchorY = rowCenter / (float) aParentMenuHeight;
+    }
+
+    public void setSelectedAspect(int aAspectMode) {
+        setSelectedItem(Math.max(VIDEO_ASPECT_AUTO, Math.min(VIDEO_ASPECT_ORIGINAL, aAspectMode)));
+    }
+
+    private void handleClick(int aAspectMode) {
+        setSelectedAspect(aAspectMode);
+        if (mDelegate != null) {
+            mDelegate.onVideoAspectClick(aAspectMode);
+        }
+    }
+
+    @Override
+    public void onGlobalFocusChanged(View oldFocus, View newFocus) {
+        if (!ViewUtils.isEqualOrChildrenOf(this, newFocus) && isVisible()) {
+            hide(KEEP_WIDGET);
+        }
+    }
+}
