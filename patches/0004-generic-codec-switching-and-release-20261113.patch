+  assert.equal(f.adapter.findEngine(f.video), second);
+  second.media = null;
+  assert.equal(f.adapter.findEngine(f.video), null);
+  f.adapter.release();
+});
+test('verified main engine survives cleared metadata but not a new content identity or engine', () => {
+  const f = fixture(), engine = new f.Hls();
+  engine.attachMedia(f.video);
+  assert.equal(f.adapter.findEngine(f.video), engine);
+  f.video.readyState = 0; f.video.duration = NaN;
+  assert.equal(f.adapter.findEngine(f.video), engine);
+  f.content.duration = 200;
+  assert.equal(f.adapter.findEngine(f.video), null);
+  f.content.duration = 100;
+  f.state.adRollStarted = true;
+  assert.equal(f.adapter.findEngine(f.video), null);
+  f.state.adRollStarted = false;
+  engine.media = null;
+  const replacement = new f.Hls(); replacement.attachMedia(f.video);
+  assert.equal(f.adapter.findEngine(f.video), null);
