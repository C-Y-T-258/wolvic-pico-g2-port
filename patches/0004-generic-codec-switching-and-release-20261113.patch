+test('another tab cannot list or execute the registered frame', async () => {
+  const f = fixture(); await f.register();
+  const other = { ...f.top, tab: { id: 2 } };
+  assert.equal((await f.list(other)).media.length, 0);
+  assert.equal((await f.receive(f.request(), other)).reason, 'frame-document-changed');
+  assert.equal(f.calls.length, 0);
