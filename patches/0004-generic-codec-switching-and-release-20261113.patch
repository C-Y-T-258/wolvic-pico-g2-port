+    addEventListener(name, fn) { listeners.set(name, fn); },
+    removeEventListener(name, fn) { if (listeners.get(name) === fn) listeners.delete(name); } };
+  class Hls {
+    static version = '1.test';
+    attachMedia(media, ...args) { calls.push({ receiver: this, media, args }); this.media = media; return 'original-result'; }
+    on() {}
+    off() {}
+    get currentLevel() { return this._currentLevel ?? 0; }
+    set currentLevel(value) { this._currentLevel = value; }
+    get nextLevel() { return this._nextLevel ?? 0; }
+    set nextLevel(value) { this._nextLevel = value; }
+    get loadLevel() { return this._loadLevel ?? 0; }
+    set loadLevel(value) { this._loadLevel = value; }
+    get nextLoadLevel() { return this._nextLoadLevel ?? 0; }
+    set nextLoadLevel(value) { this._nextLoadLevel = value; }
+    get nextAutoLevel() { return this._nextAutoLevel ?? 0; }
+    set nextAutoLevel(value) { this._nextAutoLevel = value; }
+    constructor() {
+      this.minAutoLevel = 0; this.maxAutoLevel = 3;
+      this.levels = [
+        { videoCodec: 'avc1', width: 1280, height: 720, bitrate: 2000 },
+        { videoCodec: 'av01', width: 1280, height: 720, bitrate: 1000 },
+        { videoCodec: 'avc1', width: 1920, height: 1080, bitrate: 4000 },
+        { videoCodec: 'av01', width: 1920, height: 1080, bitrate: 3000 }
+      ];
+    }
+  }
+  const original = Object.getOwnPropertyDescriptor(Hls.prototype, 'attachMedia');
+  const api = { getCurrentState: () => state, getCurrentTime: () => 12 };
+  const window = { document, location: { href: content.videoUrl }, Hls,
+    MGP: { players: { main: api }, inspectOriginal: () => ({ mainRoll: content }) },
+    addEventListener(name, fn) { lifecycle.set(name, fn); } };
+  vm.runInNewContext(source, { window, URL });
+  let active = true;
+  const descriptor = Object.getOwnPropertyDescriptor(window, 'Hls');
+  const adapter = window.WolvicMgpAdapter.create({ active: () => active });
+  return { adapter, window, document, video, ad, container, content, state, api, calls, Hls,
+    original, descriptor, listeners, lifecycle, deactivate: () => { active = false; } };
+}
+test('MGP binding observes the exact main engine without changing attach behavior or global Hls', () => {
+  const f = fixture(), engine = new f.Hls();
+  assert.equal(engine.attachMedia(f.video, 'extra'), 'original-result');
+  assert.equal(f.adapter.findEngine(f.video), engine);
+  assert.equal(f.adapter.findEngine(f.ad), null);
+  assert.deepEqual(f.calls, [{ receiver: engine, media: f.video, args: ['extra'] }]);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(f.window, 'Hls'), f.descriptor);
+  assert.equal(f.adapter.state(f.video).mgpDiscovery, 'same-master-hls-only');
+  f.adapter.release();
+  assert.deepEqual(Object.getOwnPropertyDescriptor(f.Hls.prototype, 'attachMedia'), f.original);
+});
+test('advertising, inactive documents, detached containers and ambiguous media cannot acquire an engine', () => {
+  for (const mutation of [
+    f => { f.state.adRollReady = true; },
+    f => { f.state.adRollStarted = true; },
