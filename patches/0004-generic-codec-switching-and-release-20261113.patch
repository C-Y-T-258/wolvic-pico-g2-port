+  assert.equal(result.media[0].documentId, f.documentId);
+  assert.equal(result.media[0].origin, 'https://embedded.test');
+  assert.equal(f.calls[0].options.frameId, 3);
+});
+test('top-document hosted media uses its registered document token and actual frame zero', async () => {
+  const f = fixture();
+  assert.equal((await f.register(f.top)).ok, true);
+  f.targets.set('1:0', message => ({ ok: true, documentId: f.documentId,
+    media: [{ videoId: 'hosted', hosted: true }], responseType: message.type }));
+  const listed = await f.list();
+  assert.equal(listed.media[0].frameId, 0);
+  assert.equal(f.calls[0].options.frameId, 0);
+  const result = await f.receive(f.request({ frameId: 0, videoId: 'hosted' }));
+  assert.equal(result.ok, true);
