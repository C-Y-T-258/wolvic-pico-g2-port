+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const source = fs.readFileSync(path.resolve(__dirname,
+  '../../app/src/main/assets/extensions/wolvic_vr_tools/metadata_rpc.js'), 'utf8');
+function fixture() {
+  const listeners = new Map(), replies = [], jobs = [];
+  let receive, now = 0;
+  const context = { JSON, Set, Date: { now: () => now },
+    window: { addEventListener: (name, fn) => listeners.set(name, fn),
+      dispatchEvent: event => replies.push(JSON.parse(event.detail)) },
+    document: { addEventListener: (_, fn) => { receive = fn; } },
+    CustomEvent: class { constructor(type, options) { this.type = type; this.detail = options.detail; } },
+    browser: { runtime: { sendMessage: message => new Promise(resolve => jobs.push({ message, resolve })) } }
+  };
+  vm.runInNewContext(source, context);
+  return { replies, jobs, request: (url = 'https://cdn.example/a.mp4', id = 'request') =>
+    receive({ detail: JSON.stringify({ url, id }) }), hide: () => listeners.get('pagehide')(),
+  show: () => listeners.get('pageshow')(), advance: () => { now += 60001; } };
+}
+test('metadata RPC deduplicates in-flight reads but permits a later active-content revalidation', async () => {
+  const f = fixture(), first = f.request();
+  await f.request();
+  assert.equal(f.jobs.length, 1);
+  assert.equal(f.replies[0].reason, 'metadata-document-budget');
+  f.jobs.shift().resolve({ ok: true, metadata: { codec: 'avc1.42c01e' } }); await first;
+  const second = f.request(); assert.equal(f.jobs.length, 1);
+  f.jobs.shift().resolve({ ok: false }); await second;
+});
+test('metadata results from a hidden page cannot be published after bfcache reactivation', async () => {
+  const f = fixture(), first = f.request();
+  f.hide(); f.show();
+  f.jobs.shift().resolve({ ok: true }); await first;
+  assert.equal(f.replies.length, 0);
+});
+test('metadata RPC request allowance renews without permanently disabling later SPA content', async () => {
+  const f = fixture();
+  for (let index = 0; index < 8; index++) {
+    const job = f.request();
+    f.jobs.shift().resolve({ ok: true }); await job;
+  }
+  await f.request(); assert.equal(f.jobs.length, 0);
+  assert.equal(f.replies.at(-1).reason, 'metadata-document-budget');
+  f.advance();
+  const next = f.request(); assert.equal(f.jobs.length, 1);
+  f.jobs.shift().resolve({ ok: true }); await next;
+});
