--- /dev/null
+++ b/app/src/main/assets/extensions/wolvic_vr_tools/background.js
@@ -0,0 +1,57 @@
+browser.browserAction.onClicked.addListener((tab) => {
+  if (!tab || typeof tab.id !== "number") {
+    return;
+  }
+  browser.tabs.sendMessage(tab.id, {
+    type: "wolvic-toggle-vr-tools"
+  }, { frameId: 0 }).catch((error) => {
+    console.error("[wolvic:vr-tools]", "toggle-failed", error && error.message);
+  });
+});
+
+// Content scripts cannot reliably reach the Android native handler on every
+// GeckoView build, so keep a background-page fallback for native requests.
+browser.runtime.onMessage.addListener((message, sender) => {
+  if (!message || message.type !== "wolvic-vr-native-request") {
+    return undefined;
+  }
+  // For messages sent by a content script, sender.url may identify the
+  // extension document itself. The tab URL is the authoritative page origin.
+  const senderUrl = (sender && sender.tab && sender.tab.url) ||
+    (sender && sender.url) || "";
+  if (!sender || !sender.tab || typeof sender.tab.id !== "number" ||
+      !/^https?:/i.test(senderUrl)) {
+    return Promise.resolve({ ok: false, reason: "invalid-sender" });
+  }
+  const request = message.request;
+  if (!request || typeof request !== "object") {
+    return Promise.resolve({ ok: false, reason: "invalid-request" });
+  }
+  if (request.action !== "state" && request.action !== "projection" &&
+      request.action !== "quest-site-vr") {
+    return Promise.resolve({ ok: false, reason: "invalid-action" });
+  }
+  const nativeRequest = Object.assign({}, request, { pageUri: senderUrl });
+  let timeout;
+  return Promise.race([
+    browser.runtime.sendNativeMessage("org.igalia.wolvic.vrtools", nativeRequest),
+    new Promise((resolve) => {
+      timeout = setTimeout(() => resolve({ ok: false, reason: "native-message-timeout" }), 5000);
+    })
+  ])
+    .then((response) => {
+      if (typeof response === "string") {
+        try {
+          response = JSON.parse(response);
+        } catch (_) {
+          return { ok: false, reason: "invalid-native-response" };
+        }
+      }
+      return response || { ok: false, reason: "empty-native-response" };
+    })
+    .catch((error) => ({
+      ok: false,
+      reason: error && error.message ? error.message : "native-message-failed"
+    }))
+    .finally(() => clearTimeout(timeout));
+});
