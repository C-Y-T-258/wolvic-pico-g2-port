+++ b/app/src/main/assets/extensions/wolvic_vr_tools/metadata_rpc.js
@@ -0,0 +1,35 @@
+(() => {
+  "use strict";
+  let active = true, count = 0, windowStarted = Date.now(), generation = 0;
+  const requested = new Set();
+  window.addEventListener("pagehide", () => { active = false; generation++; });
+  window.addEventListener("pageshow", () => { active = true; });
+  async function read(url) {
+    if (!active || typeof url !== "string" || url.length > 8192)
+      return { ok: false, reason: "invalid-metadata-request" };
+    const captured = generation;
+    if (Date.now() - windowStarted >= 60000) { count = 0; windowStarted = Date.now(); }
+    if (count >= 8 || requested.has(url)) return { ok: false, reason: "metadata-document-budget" };
+    count++; requested.add(url);
+    try {
+      const result = await browser.runtime.sendMessage({ type: "wolvic-mp4-metadata", url });
+      return active && captured === generation ? result || { ok: false, reason: "metadata-unavailable" } :
+        { ok: false, reason: "metadata-document-inactive" };
+    } catch (_) { return { ok: false, reason: "metadata-transport-failed" }; }
+    finally { requested.delete(url); }
+  }
+  globalThis.WolvicMetadataClient = Object.freeze({ read });
+  document.addEventListener("wolvic-mp4-metadata-request", async event => {
+    let request;
+    try { request = JSON.parse(event.detail); } catch (_) { return; }
+    if (!active || typeof request?.id !== "string" || request.id.length > 100 ||
+        typeof request.url !== "string" || request.url.length > 8192) return;
+    const captured = generation;
+    const reply = result => {
+      if (active && captured === generation) window.dispatchEvent(new CustomEvent("wolvic-mp4-metadata-result", {
+        detail: JSON.stringify({ id: request.id, ...result })
+      }));
+    };
+    reply(await read(request.url));
+  });
+})();
