@@ -0,0 +1,73 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const source = fs.readFileSync(path.resolve(__dirname,
+  '../../app/src/main/assets/extensions/wolvic_vr_tools/metadata_background.js'), 'utf8');
+function fixture(options = {}) {
+  let listener, removed, loads = 0, reads = 0, allowed = true;
+  const checkedPermissions = [];
+  const pending = [];
+  const context = {
+    URL, Promise, Date, fetch() {},
+    browser: { runtime: { getURL: value => 'extension://' + value,
+      onMessage: { addListener: fn => { listener = fn; } } },
+    permissions: { contains: async value => { checkedPermissions.push(value); return allowed; } },
+    tabs: { onRemoved: { addListener: fn => { removed = fn; } } } },
+    document: { createElement: () => ({}), head: { append(script) {
+      loads++; context.WolvicMp4Box = {}; script.onload();
+    } } },
+    WolvicMp4Metadata: { inspect: async () => {
+      reads++;
+      if (options.pending) await new Promise(resolve => pending.push(resolve));
+      return { codec: 'avc1.42c01e' };
+    } }
+  };
+  vm.runInNewContext(source, context);
+  const sender = { tab: { id: 7 }, frameId: 0, url: 'https://site.example/watch', documentId: 'doc' };
+  return { request: (url = 'https://cdn.example/movie.mp4', origin = sender) =>
+    listener({ type: 'wolvic-mp4-metadata', url }, origin),
+  unrelated: () => listener({ type: 'unrelated' }, sender),
+  revoke: () => { allowed = false; }, removed: () => removed(7),
+  loads: () => loads, reads: () => reads, pending, checkedPermissions };
+}
+test('metadata background rejects malformed senders and local addresses without loading the parser', async () => {
+  const f = fixture();
+  assert.equal(f.unrelated(), undefined);
+  for (const url of ['http://cdn.example/a', 'https://127.0.0.1/a', 'https://10.0.0.1/a',
+    'https://localhost/a', 'https://host.local/a', 'https://[::1]/a', 'https://a:b@cdn.example/a']) {
+    assert.equal((await f.request(url)).reason, 'invalid-metadata-request');
+  }
+  assert.equal((await f.request(undefined, {})).reason, 'invalid-metadata-request');
+  assert.equal(f.loads(), 0); assert.equal(f.reads(), 0);
+});
+test('host permissions are checked before lazy parser loading', async () => {
+  const f = fixture(); f.revoke();
+  assert.equal((await f.request()).reason, 'metadata-host-permission-unavailable');
+  assert.equal(f.loads(), 0); assert.equal(f.reads(), 0);
+});
+test('permission match patterns exclude an explicit media port', async () => {
+  const f = fixture();
+  assert.equal((await f.request('https://cdn.example:8443/movie.mp4')).ok, true);
+  assert.equal(f.checkedPermissions[0].origins[0], 'https://cdn.example/*');
