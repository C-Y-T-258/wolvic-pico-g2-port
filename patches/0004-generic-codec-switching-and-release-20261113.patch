+    changeDocument: () => { documentId = 'document-2'; }, deactivate: () => { active = false; },
+    setIntent: value => { intent = value; }, setQuality: value => { quality = value; } };
+  f.ready = async () => {
+    adapter.independentState(video);
+    await new Promise(resolve => setImmediate(resolve));
+    return adapter.independentState(video);
+  };
