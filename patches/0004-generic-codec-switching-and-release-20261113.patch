+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+const vm = require("node:vm");
+
+const bridgePath = path.resolve(__dirname, "../../app/src/main/assets/extensions/wolvic_vr_tools/page_bridge.js");
+const bridge = fs.readFileSync(bridgePath, "utf8");
+new vm.Script(bridge, { filename: "page-bridge.js" });
+
+class Events {
+  constructor() { this.listeners = new Map(); }
+  addEventListener(name, listener) {
+    if (!this.listeners.has(name)) this.listeners.set(name, new Set());
+    this.listeners.get(name).add(listener);
+  }
+  removeEventListener(name, listener) { this.listeners.get(name)?.delete(listener); }
+  dispatchEvent(event) {
+    for (const listener of [...(this.listeners.get(event.type) || [])]) listener(event);
+    return true;
+  }
+}
+
+class Clock {
+  constructor() { this.now = 0; this.serial = 0; this.tasks = new Map(); }
+  setTimeout(fn, delay = 0) {
+    const id = ++this.serial;
+    this.tasks.set(id, { fn, at: this.now + delay });
+    return id;
+  }
+  clearTimeout(id) { this.tasks.delete(id); }
+  async until(predicate) {
+    for (let step = 0; step < 2000; step++) {
+      await new Promise(setImmediate);
+      if (predicate()) return;
+      const next = [...this.tasks].sort((a, b) => a[1].at - b[1].at || a[0] - b[0])[0];
+      assert.ok(next, "No pending timers, but the bridge did not answer");
+      this.tasks.delete(next[0]);
+      this.now = next[1].at;
+      next[1].fn();
+    }
+    assert.fail("Bridge exceeded the bounded virtual test clock");
+  }
+}
+
+function fixture(options = {}) {
+  const clock = new Clock();
+  const window = new Events();
+  const document = new Events();
+  const video = new Events();
+  const player = new Events();
+  const stats = { sourceCalls: [], nativeLoads: 0, pauses: 0, plays: 0, resets: 0, inits: 0 };
+  const attributes = new Map();
+  const source = { src: "https://media.test/master.m3u8", type: "application/x-mpegURL" };
+  const state = { time: 45, paused: options.paused !== false, start: 0 };
+  const rect = { left: 0, top: 0, right: 100, bottom: 100, width: 100, height: 100 };
+  Object.assign(video, {
+    isConnected: true, readyState: 4, networkState: 1, seeking: false, error: null,
+    srcObject: null, mediaKeys: null, videoWidth: 1440, videoHeight: 720, duration: 120,
+    muted: false, volume: 0.7, playbackRate: 1.25, preload: "none",
+    currentSrc: "blob:https://site.test/initial", src: "",
+    style: { opacity: "0", zIndex: "-1" }, mozPresentedFrames: 20,
+    getAttribute: (name) => attributes.get(name) || null,
+    setAttribute: (name, value) => attributes.set(name, value),
+    getBoundingClientRect: () => rect
+  });
+  Object.defineProperty(video, "paused", { get: () => state.paused });
+  Object.defineProperty(video, "currentTime", {
+    get: () => state.time + (state.paused ? 0 : (clock.now - state.start) / 1000 * video.playbackRate),
+    set: (time) => {
+      state.time = time;
+      state.start = clock.now;
+      video.seeking = true;
+      clock.setTimeout(() => { video.seeking = false; video.dispatchEvent({ type: "seeked" }); }, 20);
+    }
+  });
+  video.pause = () => {
+    stats.pauses++;
+    state.time = video.currentTime;
+    state.paused = true;
+  };
+  video.play = () => {
+    stats.plays++;
+    if (options.rejectPlay) return Promise.reject(new Error("NotAllowedError"));
+    state.start = clock.now;
+    state.paused = false;
+    return Promise.resolve();
+  };
+  video.load = () => {
+    stats.nativeLoads++;
+    video.readyState = 3;
+    clock.setTimeout(() => {
+      video.dispatchEvent({ type: "loadedmetadata" });
+      video.dispatchEvent({ type: "canplay" });
+    }, 30);
+  };
