+});
+test('pagehide releases wrappers and pageshow reattaches without overwriting site changes', () => {
+  const f = fixture();
+  f.lifecycle.get('pagehide')();
+  assert.deepEqual(Object.getOwnPropertyDescriptor(f.Hls.prototype, 'attachMedia'), f.original);
+  assert.equal(f.listeners.size, 0);
