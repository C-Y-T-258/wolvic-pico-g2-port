--- /dev/null
+++ b/tools/tests/media-adapters.test.cjs
@@ -0,0 +1,151 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { parseHlsMasterPlaylist, discoverPlaylistUrls, codecFamily,
+  summarizeCodecCandidates, canonicalCodecCandidate, normalizeCodecCandidates,
+  hasCodecPair, sameCodecContent } = require(
+  "../../app/src/main/assets/extensions/wolvic_vr_tools/media_adapters.js");
+
+const manifest = [
+  "#EXTM3U",
+  "#EXT-X-STREAM-INF:BANDWIDTH=350000,AVERAGE-BANDWIDTH=290000,RESOLUTION=426x240,CODECS=\"avc1.4d4015,mp4a.40.2\"",
+  "240p/index.m3u8",
+  "#EXT-X-STREAM-INF:BANDWIDTH=900000,RESOLUTION=640x360,CODECS=\"avc1.4d401e,mp4a.40.2\"",
+  "360p/index.m3u8",
+  "#EXT-X-STREAM-INF:BANDWIDTH=1400000,RESOLUTION=854x480,CODECS=\"avc1.4d401f,mp4a.40.2\"",
+  "480p/index.m3u8"
+].join("\n");
+
+test("parses HLS master variants into explicit structured candidates", () => {
+  const result = parseHlsMasterPlaylist(
+    manifest,
+    "https://cdn.example.test/hls/master.m3u8?token=x",
+    "video-123");
+  assert.equal(result.ok, true);
+  assert.equal(result.kind, "hls-master");
+  assert.equal(result.contentId, "video-123");
+  assert.equal(result.candidates.length, 3);
+  assert.deepEqual(result.candidates[0], {
+    kind: "hls-variant",
+    contentId: "video-123",
+    manifestUrl: "https://cdn.example.test/hls/master.m3u8?token=x",
+    url: "https://cdn.example.test/hls/240p/index.m3u8",
+    bandwidth: 350000,
+    averageBandwidth: 290000,
+    width: 426,
+    height: 240,
+    codecs: "avc1.4d4015,mp4a.40.2",
+    frameRate: null,
+    audioGroup: "",
+    subtitlesGroup: "",
+    label: "240p"
+  });
+});
+
+test("rejects a media playlist without variants", () => {
+  const result = parseHlsMasterPlaylist(
+    "#EXTM3U\n#EXTINF:4,\nsegment-1.ts",
+    "https://cdn.example.test/hls/480p/index.m3u8",
+    "video-123");
+  assert.equal(result.ok, false);
+  assert.equal(result.reason, "no-variants");
+});
+
+test("rejects non-HLS input", () => {
+  const result = parseHlsMasterPlaylist("<MPD></MPD>", "https://cdn.example.test/a.mpd", "x");
+  assert.equal(result.ok, false);
+  assert.equal(result.reason, "not-hls");
+});
+
+test("drops variants with unusable URLs", () => {
+  const result = parseHlsMasterPlaylist(
+    "#EXTM3U\n#EXT-X-STREAM-INF:RESOLUTION=640x360\njavascript:bad",
+    "https://cdn.example.test/master.m3u8",
+    "video-123");
+  assert.equal(result.ok, false);
+  assert.equal(result.reason, "no-variants");
+});
+
+test("discovers unique HTTP playlist resources only", () => {
+  assert.deepEqual(discoverPlaylistUrls([
+    { name: "https://cdn.example.test/master.m3u8?x=1" },
+    { name: "https://cdn.example.test/master.m3u8?x=1" },
+    { name: "https://cdn.example.test/video.mpd" },
+    { name: "blob:https://example.test/playlist.m3u8" },
+    { name: "https://cdn.example.test/segment.ts" }
+  ]), [
+    "https://cdn.example.test/master.m3u8?x=1",
+    "https://cdn.example.test/video.mpd"
+  ]);
+});
+
+test("classifies codec families without treating resolution as codec", () => {
+  assert.equal(codecFamily("av01.0.09M.08,mp4a.40.2"), "AV1");
+  assert.equal(codecFamily("avc1.640029,mp4a.40.2"), "H.264");
+  assert.equal(codecFamily("hev1.2.4.L120.B0,mp4a.40.2"), "HEVC");
+  assert.equal(codecFamily("vp09.00.51.08,opus"), "VP9");
+  assert.equal(codecFamily(""), "");
+});
+
+test("summarizes one master as one codec source", () => {
+  const parsed = parseHlsMasterPlaylist(
+    "#EXTM3U\n#EXT-X-STREAM-INF:RESOLUTION=640x360,CODECS=\"avc1.4d401e,mp4a.40.2\"\n360/index.m3u8",
+    "https://cdn.example.test/hls/master.m3u8",
+    "video-123");
+  assert.deepEqual(summarizeCodecCandidates(parsed, "h264"), {
+    ok: true,
+    sourceId: "h264",
+    contentId: "video-123",
+    manifestUrl: "https://cdn.example.test/hls/master.m3u8",
+    codec: "H.264",
+    candidates: parsed.candidates
+  });
+});
+
+test("rejects a master that mixes codec families", () => {
+  const parsed = parseHlsMasterPlaylist(
+    "#EXTM3U\n#EXT-X-STREAM-INF:RESOLUTION=640x360,CODECS=\"avc1.4d401e,mp4a.40.2\"\n360-avc.m3u8\n#EXT-X-STREAM-INF:RESOLUTION=640x360,CODECS=\"av01.0.01M.08,mp4a.40.2\"\n360-av1.m3u8",
+    "https://cdn.example.test/hls/master.m3u8",
+    "video-123");
+  const result = summarizeCodecCandidates(parsed, "mixed");
+  assert.equal(result.ok, false);
+  assert.equal(result.reason, "mixed-codec-master");
+});
+
+test("canonical codec candidates preserve identity, evidence and playback metadata", () => {
+  assert.deepEqual(canonicalCodecCandidate({
+    id: 7, codec: "AV1", width: 1280, height: 720,
+    url: "https://cdn.example.test/av1.m3u8", contentId: "same",
+    codecEvidence: "manifest"
+  }), {
+    id: "7", nodeIndex: "7", codec: "AV1", width: 1280, height: 720,
+    quality: "720p", label: "AV1", type: "application/octet-stream",
+    protocol: "https:", audio: "", contentId: "same", evidence: "manifest",
+    selectable: true, supported: true, url: "https://cdn.example.test/av1.m3u8",
+    codecEvidence: "manifest"
+  });
+});
+
+test("codec normalization requires two selectable codec families", () => {
+  const one = normalizeCodecCandidates([
+    { id: "a", codec: "H.264", supported: true },
+    { id: "b", codec: "H.264", supported: true }
+  ]);
+  assert.equal(one.hasPair, false);
+  assert.equal(one.reason, "fewer-than-two-codecs");
+  const two = normalizeCodecCandidates([
+    { id: "a", codec: "H.264", supported: true },
+    { id: "b", codec: "AV1", selectable: true }
+  ]);
+  assert.equal(two.hasPair, true);
+  assert.deepEqual(two.families.sort(), ["AV1", "H.264"]);
+  assert.equal(hasCodecPair(two.candidates), true);
+});
+
+test("codec content identity rejects candidates from another content or document", () => {
+  const base = { contentId: "same", codecContext: { document: "doc", generation: 1 } };
+  assert.equal(sameCodecContent(base, { ...base }), true);
+  assert.equal(sameCodecContent(base, { ...base, contentId: "other" }), false);
+  assert.equal(sameCodecContent(base, {
+    contentId: "same", codecContext: { document: "other-doc", generation: 1 }
+  }), false);
+});
