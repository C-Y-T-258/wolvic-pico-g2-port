+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const source = fs.readFileSync(path.resolve(__dirname,
+  '../../app/src/main/assets/extensions/wolvic_vr_tools/explicit_source.js'), 'utf8');
+function actual(name) {
+  const expression = new RegExp('^    (?:async )?function ' + name + '\\(', 'm');
+  const start = source.search(expression);
+  assert.ok(start >= 0, name);
+  const rest = source.slice(start + 1), next = rest.search(/^    (?:async )?function /m);
+  return source.slice(start, next < 0 ? source.length : start + 1 + next);
+}
+function fixture(options = {}) {
+  const writes = [], identity = {}, metadata = [];
+  let current = true;
+  const video = { currentSrc: 'https://cdn.test/avc.mp4', src: '', currentTime: 37,
+    paused: !!options.paused, playbackRate: 1.5, muted: false, volume: 0.4, duration: 100,
+    getAttribute: () => null,
+    setAttribute(name, value) { writes.push([name, value]); this.currentSrc = value; },
+    removeAttribute(name) { writes.push(['remove', name]); this.currentSrc = 'https://cdn.test/first.mp4'; },
+    async play() { writes.push(['play']); this.paused = false; },
+    pause() { writes.push(['pause']); this.paused = true; } };
+  const c = vm.createContext({
+    getMediaIdentity: () => identity, mediaIdentityStillCurrent: () => current,
+    normalizedSource: value => value, Number, Error, setTimeout, clearTimeout,
+    waitForMediaPresentation: async () => {},
+    waitForMediaMetadata: async (target, expected) => {
+      metadata.push(expected);
+      target.playbackRate = 1; target.paused = false;
+      if (options.navigateDuringLoad) current = false;
+      if (target.currentSrc !== expected) throw Error('source-not-selected');
+    }
+  });
+  for (const name of ['snapshotMediaState', 'resumeMediaPlayback', 'restoreMediaState']) vm.runInContext(actual(name), c);
+  return { video, writes, metadata, snapshot: () => c.snapshotMediaState(video),
+    restore: original => c.restoreMediaState(video, original), navigate: () => { current = false; } };
+}
+test('failed target restores exact non-first source, rate and paused state', async () => {
+  const f = fixture({ paused: true }), original = f.snapshot();
+  f.video.currentSrc = 'https://cdn.test/failed-av1.mp4';
+  f.video.currentTime = 0; f.video.playbackRate = 1;
+  await f.restore(original);
+  assert.equal(f.video.currentSrc, original.currentSource);
+  assert.equal(f.video.currentTime, 37);
+  assert.equal(f.video.playbackRate, 1.5);
+  assert.equal(f.video.paused, true);
+  assert.equal(f.video.volume, 0.4);
+  assert.equal(f.video.muted, false);
+  assert.deepEqual(f.metadata, ['https://cdn.test/avc.mp4', 'https://cdn.test/avc.mp4']);
+});
+test('restoration resumes an originally playing video', async () => {
