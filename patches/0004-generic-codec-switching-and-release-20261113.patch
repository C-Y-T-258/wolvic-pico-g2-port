+});
+test('unready main media cannot acquire initial ownership', () => {
+  const f = fixture(), engine = new f.Hls();
+  f.video.readyState = 0;
+  engine.attachMedia(f.video);
+  assert.equal(f.adapter.findEngine(f.video), null);
+  f.adapter.release();
+});
+test('explicit MGP codec choice maps native quality and Auto without deleting levels or replacing the engine', () => {
+  const f = fixture(), engine = new f.Hls();
+  engine.attachMedia(f.video);
+  const levels = engine.levels, policy = f.adapter.selectCodec(f.video, engine, 'AV1');
+  assert.ok(policy);
+  engine.nextLevel = 2; engine.loadLevel = 2; engine.nextLoadLevel = 0;
+  assert.equal(engine.nextLevel, 3); assert.equal(engine.loadLevel, 3);
+  assert.equal(engine.nextLoadLevel, 1);
+  engine._nextAutoLevel = 2;
+  assert.equal(engine.nextAutoLevel, 3);
+  engine.loadLevel = -1;
+  assert.equal(engine.loadLevel, -1);
+  assert.equal(engine.levels, levels);
+  policy.rollback('H.264');
+  engine.loadLevel = 3;
+  assert.equal(engine.loadLevel, 2);
+  policy.restore();
+  assert.equal(Object.hasOwn(engine, 'loadLevel'), false);
+  engine.loadLevel = 3;
+  assert.equal(engine.loadLevel, 3);
+  f.adapter.release();
+});
+test('codec restriction releases on new content, catalogue, ads, absent quality or pagehide', () => {
+  for (const mutate of [
+    (f, e) => { f.content.duration = 200; },
+    (f, e) => { e.levels = [...e.levels]; },
+    (f, e) => { e.url = 'https://other.test/master.m3u8'; },
+    (f, e) => { f.api.getCurrentState = () => { throw Error('site-disposed'); }; },
+    (f, e) => { f.state.adRollStarted = true; },
+    (f, e) => { e.levels[3].height = 900; },
+    (f, e) => { f.lifecycle.get('pagehide')(); }
+  ]) {
+    const f = fixture(), engine = new f.Hls(); engine.attachMedia(f.video);
+    assert.ok(f.adapter.selectCodec(f.video, engine, 'AV1'));
+    mutate(f, engine); engine.loadLevel = 2;
+    assert.equal(engine.loadLevel, 2);
+    assert.equal(Object.hasOwn(engine, 'loadLevel'), false);
+    f.adapter.release();
+  }
+});
+test('failed second selection restores the previously selected codec; site property replacement is preserved', () => {
+  const f = fixture(), engine = new f.Hls(); engine.attachMedia(f.video);
+  assert.ok(f.adapter.selectCodec(f.video, engine, 'AV1'));
+  const second = f.adapter.selectCodec(f.video, engine, 'H.264');
+  second.restore();
+  engine.loadLevel = 2;
+  assert.equal(engine.loadLevel, 3);
+  Object.defineProperty(engine, 'loadLevel', { configurable: true, value: 88 });
+  f.adapter.release();
+  assert.equal(engine.loadLevel, 88);
+});
+test('late library script loading is observed without a global setter or polling', () => {
+  const f = fixture();
+  f.adapter.release();
+  delete f.window.Hls;
+  const adapter = f.window.WolvicMgpAdapter.create({ active: () => true });
+  assert.equal('Hls' in f.window, false);
+  f.window.Hls = f.Hls;
+  f.listeners.get('load')({ target: { tagName: 'SCRIPT' } });
