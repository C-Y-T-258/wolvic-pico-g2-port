+  global.WolvicMediaAdapters = Object.freeze({
+    parseHlsMasterPlaylist,
+    codecFamily,
+    summarizeCodecCandidates,
+    summarizeCodecSources,
+    selectHlsCodecCandidates,
+    codecDiscoveryKey,
+    canonicalCodecCandidate,
+    normalizeCodecCandidates,
+    codecCandidateFamilies,
+    hasCodecPair,
+    sameCodecContent,
+    isHlsSource,
+    discoverPlaylistUrls,
+    isPlaylistUrl
+  });
