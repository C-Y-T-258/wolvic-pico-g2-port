+    contains: (item) => item === video,
+    querySelectorAll: () => [video]
+  };
+  const audio = [{ id: "audio-en", language: "en", kind: "main", enabled: true }];
+  function makeTech(src = source, restoring = false) {
+    const representations = [720, 1080].map((height) => {
+      let enabled = restoring || height === 720;
