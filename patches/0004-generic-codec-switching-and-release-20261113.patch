+    tagName: "CANVAS", isConnected: true, getBoundingClientRect: () => rect,
+    parentNode: { removeChild(item) { item.isConnected = false; item.parentNode = null; } }
+  };
+  const plugin = {
+    player_: player, initialized_: true, currentProjection_: "180_LR", defaultProjection_: "180_LR",
+    vrDisplay: { isPresenting: !!options.presenting },
+    renderedCanvas: canvas, handleResize_: () => {},
+    off: (target, name, fn) => target.removeEventListener(name, fn),
+    on: (target, name, fn) => target.addEventListener(name, fn),
+    reset() {
+      stats.resets++;
+      plugin.initialized_ = false;
+      canvas.isConnected = false;
+      canvas.parentNode = null;
+    },
+    init() {
+      stats.inits++;
+      if (options.failRenderer) throw new Error("renderer-init-failed");
+      plugin.initialized_ = true;
+      canvas.isConnected = true;
+    }
+  };
+  player.vr = () => plugin;
+  player.addEventListener("loadedmetadata", plugin.init);
+  const settings = { vid: "same-content", videoData: { vid: "same-content" }, isInVast: false };
+  if (options.site) player.EPvideo = { getSettings: () => settings };
+  const location = { href: "https://site.test/watch/1" };
+  Object.assign(document, {
+    baseURI: location.href, fullscreenElement: video,
+    querySelectorAll: (selector) => selector === "video" ? [video] :
+      selector === "canvas" && options.covered ? [canvas] : [],
+    elementFromPoint: () => options.covered ? canvas : video
+  });
+  window.videojs = options.noPlayer ? undefined : { getPlayers: () => ({ main: player }) };
+  const responses = new Map();
+  window.addEventListener("wolvic-videojs-vr-result", (event) => {
+    const value = JSON.parse(event.detail);
+    responses.set(value.requestId, value);
+  });
+  const api = { clock, window, document, video, player, plugin, stats, settings, location, source };
+  vm.runInNewContext(bridge, {
+    window, document, location, URL, Date: { now: () => clock.now },
+    CustomEvent: class { constructor(type, init) { this.type = type; this.detail = init.detail; } },
+    setTimeout: clock.setTimeout.bind(clock), clearTimeout: clock.clearTimeout.bind(clock),
+    requestAnimationFrame: (fn) => clock.setTimeout(fn, 16)
+  });
+  let serial = 0;
+  api.send = (request) => {
+    const requestId = request.requestId || `test-${++serial}`;
+    document.dispatchEvent({ type: "wolvic-videojs-vr-command", detail: JSON.stringify({
+      ...request, requestId, videoId: video.getAttribute("data-wolvic-vr-tools-video-id")
+    }) });
+    return requestId;
+  };
+  api.result = async (id) => {
+    await clock.until(() => responses.has(id));
+    return responses.get(id);
+  };
+  api.command = async (request) => api.result(api.send(request));
+  api.prepare = () => api.command({ action: "prepare-takeover" });
+  return api;
+}
