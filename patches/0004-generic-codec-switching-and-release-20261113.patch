+    const urls = [];
+    for (const entry of Array.isArray(resourceEntries) ? resourceEntries : []) {
+      const url = typeof entry === "string" ? entry :
+        (entry && typeof entry.name === "string" ? entry.name : "");
+      if (!isPlaylistUrl(url)) continue;
+      try {
+        const parsed = new URL(url);
+        if (parsed.protocol !== "http:" && parsed.protocol !== "https:") continue;
+        if (!urls.includes(parsed.href)) urls.push(parsed.href);
+      } catch (_) {}
+    }
+    return urls;
+  }
