+(function installWolvicMediaAdapters(global) {
+  "use strict";
+
+  function attributeMap(value) {
+    const result = {};
+    const parts = [];
+    let start = 0;
+    let quoted = false;
+    for (let index = 0; index < String(value || "").length; index += 1) {
+      const character = String(value || "")[index];
+      if (character === "\"") quoted = !quoted;
+      if (character === "," && !quoted) {
+        parts.push(String(value || "").slice(start, index));
+        start = index + 1;
+      }
+    }
+    parts.push(String(value || "").slice(start));
+    for (const part of parts) {
+      const separator = part.indexOf("=");
+      if (separator < 0) continue;
+      const key = part.slice(0, separator).trim().toUpperCase();
+      let item = part.slice(separator + 1).trim();
+      if (item.startsWith("\"") && item.endsWith("\"")) {
+        item = item.slice(1, -1).replace(/""/g, "\"");
+      }
+      if (key) result[key] = item;
+    }
+    return result;
+  }
+
+  function finiteNumber(value) {
+    const number = Number(value);
+    return Number.isFinite(number) ? number : null;
+  }
+
+  function resolveUrl(raw, baseUrl) {
+    try {
+      const url = new URL(String(raw || "").trim(), baseUrl);
+      if (url.protocol !== "http:" && url.protocol !== "https:") return "";
+      return url.href;
+    } catch (_) {
+      return "";
+    }
+  }
+
+  function parseResolution(value) {
+    const match = String(value || "").match(/^(\d+)x(\d+)$/i);
+    return match ? { width: Number(match[1]), height: Number(match[2]) } : {};
+  }
+
+  function codecFamily(codecs) {
+    const value = String(codecs || "").toLowerCase();
+    if (/\bav0?1[\w.]*/i.test(value) || value.includes("av01")) return "AV1";
+    if (value.includes("avc1") || value.includes("avc3")) return "H.264";
+    if (value.includes("hev1") || value.includes("hvc1")) return "HEVC";
+    if (value.includes("vp09") || value.includes("vp9")) return "VP9";
+    if (value.includes("vp08") || value.includes("vp8")) return "VP8";
+    return "";
+  }
+
+  function summarizeCodecCandidates(parsed, sourceId) {
+    if (!parsed || !parsed.ok || !Array.isArray(parsed.candidates)) {
+      return { ok: false, reason: parsed && parsed.reason || "no-variants" };
+    }
+    const codecs = parsed.candidates.map(item => codecFamily(item.codecs));
+    const families = [...new Set(codecs.filter(Boolean))];
+    if (families.length > 1) {
+      return { ok: false, reason: "mixed-codec-master", families };
+    }
+    if (!families.length || codecs.some(codec => !codec)) {
+      return { ok: false, reason: "codec-unknown", families };
+    }
+    return {
+      ok: true,
+      sourceId: String(sourceId || ""),
+      contentId: parsed.contentId,
+      manifestUrl: parsed.manifestUrl,
+      codec: families[0],
+      candidates: parsed.candidates
+    };
+  }
+
+  function parseHlsMasterPlaylist(text, manifestUrl, contentId) {
+    const lines = String(text || "").split(/\r?\n/).map(line => line.trim());
+    if (lines[0] !== "#EXTM3U") {
+      return { ok: false, reason: "not-hls" };
+    }
+    const candidates = [];
+    for (let index = 0; index < lines.length; index += 1) {
+      const line = lines[index];
+      if (!line.startsWith("#EXT-X-STREAM-INF:")) continue;
+      const attributes = attributeMap(line.slice("#EXT-X-STREAM-INF:".length));
+      let uri = "";
+      for (let next = index + 1; next < lines.length; next += 1) {
+        if (!lines[next]) continue;
+        if (lines[next].startsWith("#")) break;
+        uri = resolveUrl(lines[next], manifestUrl);
+        break;
+      }
+      if (!uri) continue;
+      const resolution = parseResolution(attributes.RESOLUTION);
+      candidates.push({
+        kind: "hls-variant",
+        contentId: String(contentId || ""),
+        manifestUrl: resolveUrl(manifestUrl, manifestUrl),
+        url: uri,
+        bandwidth: finiteNumber(attributes.BANDWIDTH),
+        averageBandwidth: finiteNumber(attributes["AVERAGE-BANDWIDTH"]),
+        width: resolution.width || 0,
+        height: resolution.height || 0,
+        codecs: attributes.CODECS || "",
+        frameRate: finiteNumber(attributes["FRAME-RATE"]),
+        audioGroup: attributes.AUDIO || "",
+        subtitlesGroup: attributes.SUBTITLES || "",
+        label: resolution.height ? `${resolution.height}p` :
+          (attributes.NAME || attributes.CODECS || uri)
